<header class="conditional-header" data-conditional-header aria-label="Primary navigation">
  <a class="conditional-header__brand" href="#inicio" aria-label="VixenBliss Agency inicio">
    <img
      src="/brand/Imagotipo-Vixen-Agency-claro-horizontal.png"
      alt="Imagotipo horizontal de VixenBliss Agency"
      width="1024"
      height="308"
    />
  </a>
  <nav class="conditional-header__nav" aria-label="Homepage sections">
    <a href="#inicio">Inicio</a>
    <a href="#about">About</a>
    <a href="/contact">Contacto</a>
    <a href="/privacy">Legal</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-conditional-header]");
  const hero = document.querySelector<HTMLElement>("[data-hero-section]");

  if (header && hero && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.dataset.visible = entry.isIntersecting ? "true" : "false";
      },
      {
        root: null,
        threshold: 0.12,
      },
    );

    observer.observe(hero);
  }
</script>

<style>
  .conditional-header {
    position: fixed;
    top: max(0.8rem, env(safe-area-inset-top));
    right: 0.85rem;
    left: 0.85rem;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    opacity: 1;
    transition:
      opacity 180ms ease,
      visibility 180ms ease;
  }

  .conditional-header[data-visible="false"] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .conditional-header__brand,
  .conditional-header__nav a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
  }

  .conditional-header__brand {
    flex: 0 0 auto;
    line-height: 1;
  }

  .conditional-header__brand img {
    width: clamp(5.8rem, 18vw, 7rem);
    height: auto;
    object-fit: contain;
  }

  .conditional-header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1;
  }

  .conditional-header__nav a:hover,
  .conditional-header__nav a:focus-visible,
  .conditional-header__brand:hover,
  .conditional-header__brand:focus-visible {
    color: #fff;
  }

  @media (max-width: 420px) {
    .conditional-header {
      align-items: flex-start;
      gap: 0.6rem;
    }

    .conditional-header__nav {
      max-width: 12rem;
      gap: 0.55rem 0.7rem;
    }
  }

  @media (min-width: 768px) {
    .conditional-header {
      top: max(1.1rem, env(safe-area-inset-top));
      right: 1.4rem;
      left: 1.4rem;
    }

    .conditional-header__nav {
      gap: 1rem;
      font-size: 0.78rem;
    }
  }
</style>
