---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<aside class="notice">
  <strong>{title}</strong>
  <p>{body}</p>
</aside>

<style>
  .notice {
    padding: 1rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .notice p {
    margin: 0.45rem 0 0;
    color: rgba(245, 245, 247, 0.7);
  }
</style>
