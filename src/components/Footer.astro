---
const year = new Date().getFullYear();

const links = [
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/cookies", label: "Cookies" },
  { href: "/contact", label: "Contact" },
  { href: "/about", label: "About" },
] as const;
---

<footer class="site-footer" aria-label="Site links">
  <nav class="site-footer__nav" aria-label="Legal and company">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <p>© {year} VixenBliss Agency</p>
</footer>

<style>
  .site-footer {
    position: fixed;
    top: max(0.55rem, env(safe-area-inset-top));
    right: 0.65rem;
    left: 0.65rem;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem 0.75rem;
    max-width: 52rem;
    margin: 0 auto;
    padding: 0.42rem 0.58rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 0.5rem;
    background: rgba(7, 7, 10, 0.62);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
    line-height: 1.2;
    backdrop-filter: blur(14px);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.7rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: #fff;
  }

  .site-footer p {
    margin: 0;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .site-footer {
      right: 1rem;
      left: 1rem;
      width: fit-content;
      padding: 0.46rem 0.7rem;
      font-size: 0.75rem;
    }
  }
</style>
