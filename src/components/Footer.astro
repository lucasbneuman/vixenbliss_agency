---
const year = new Date().getFullYear();

const links = [
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/cookies", label: "Cookies" },
  { href: "/contact", label: "Contact" },
  { href: "/about", label: "About" },
] as const;
---

<footer class="site-footer" aria-label="Site links">
  <nav class="site-footer__nav" aria-label="Legal and company">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <p>&copy; {year} VixenBliss Agency</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem 0.75rem;
    min-height: 3.5rem;
    padding: 0.72rem 1rem max(0.72rem, env(safe-area-inset-bottom));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: #050507;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.7rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: #fff;
  }

  .site-footer p {
    margin: 0;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding: 0.8rem 1.25rem;
      font-size: 0.75rem;
    }
  }
</style>
