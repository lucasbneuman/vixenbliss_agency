---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated = "April 24, 2026" } = Astro.props;
---

<Layout title={`${title} | VixenBliss Agency`} description={description}>
  <main class="legal-page">
    <article class="legal-page__content">
      <p class="legal-page__eyebrow">VixenBliss Agency</p>
      <h1>{title}</h1>
      <slot />
      <p class="legal-page__updated">Last updated: {updated}</p>
    </article>
  </main>
</Layout>

<style>
  .legal-page {
    min-height: 100vh;
    min-height: 100svh;
    padding: 7.25rem 1rem 3rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), transparent 18rem),
      #050507;
  }

  .legal-page__content {
    width: min(100%, 48rem);
    margin: 0 auto;
  }

  .legal-page__eyebrow {
    width: fit-content;
    margin: 0 0 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 1.3rem;
    color: #fff;
    font-size: clamp(2.4rem, 10vw, 4.6rem);
    line-height: 0.95;
  }

  :global(.legal-page h2) {
    margin: 2rem 0 0.55rem;
    color: #fff;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  :global(.legal-page p),
  :global(.legal-page li) {
    color: rgba(255, 255, 255, 0.76);
  }

  :global(.legal-page p) {
    margin: 0 0 1rem;
  }

  :global(.legal-page ul) {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.15rem;
  }

  :global(.legal-page a) {
    color: var(--accent-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .legal-page__updated {
    margin-top: 2.3rem;
    color: rgba(255, 255, 255, 0.54);
    font-size: 0.9rem;
  }

  @media (min-width: 768px) {
    .legal-page {
      padding-top: 8rem;
    }
  }
</style>
