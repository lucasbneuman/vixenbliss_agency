---
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "VixenBliss Agency",
  description = "Mobile-first video web app foundation for VixenBliss Agency.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/brand/Favicon-VixenBliss.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080c" />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4DKXZN23P9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-4DKXZN23P9");
    </script>
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #08080c;
    --bg-elevated: rgba(20, 20, 28, 0.88);
    --text: #f5f5f7;
    --text-muted: rgba(245, 245, 247, 0.68);
    --accent: #ff5f87;
    --accent-strong: #ff7b9d;
    --border: rgba(255, 255, 255, 0.1);
    --shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
    font-family:
      Inter, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at top, rgba(255, 95, 135, 0.22), transparent 38%),
      linear-gradient(180deg, #11111a 0%, var(--bg) 45%, #050507 100%);
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--text);
  }

  body {
    min-width: 320px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
  }

  img {
    display: block;
    max-width: 100%;
  }
</style>
